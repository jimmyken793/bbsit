[Unit]
Description=BBSit - Pull-based deployment daemon
After=network-online.target docker.service podman.service
Wants=network-online.target docker.service podman.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/bbsit
ExecStart=/opt/bbsit/bbsit --config /opt/bbsit/config.yaml
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# /run/bbsit for the admin Unix socket used by bbsit-ctl
RuntimeDirectory=bbsit
RuntimeDirectoryMode=0755

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bbsit

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
